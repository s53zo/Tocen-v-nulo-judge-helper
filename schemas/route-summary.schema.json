{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tocen-v-nulo.local/schemas/route-summary.schema.json",
  "title": "Precision Route Planner route summary",
  "type": "object",
  "required": ["schemaVersion", "appVersion", "generatedAt", "speedKnots", "totalDistanceKm", "totalDistanceNm", "map", "waypoints", "legs", "compliance", "photos", "warnings"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "appVersion": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "speedKnots": { "type": "number", "exclusiveMinimum": 0 },
    "totalDistanceKm": { "type": "number", "minimum": 0 },
    "totalDistanceNm": { "type": "number", "minimum": 0 },
    "map": { "type": "object" },
    "waypoints": { "type": "array", "minItems": 2 },
    "legs": { "type": "array", "minItems": 1 },
    "cropped": { "type": ["object", "null"] },
    "compliance": { "type": "object" },
    "photos": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
