{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tocen-v-nulo.local/schemas/photo-summary.schema.json",
  "title": "Precision Route Planner photo summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "counts", "photos", "findings"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "status": { "enum": ["ok", "against-rules", "manual-review"] },
    "counts": {
      "type": "object",
      "required": ["photos", "enroutePhotos", "routeTasks", "violations", "warnings", "acceptedExceptions"],
      "additionalProperties": false,
      "properties": {
        "photos": { "type": "integer", "minimum": 0 },
        "enroutePhotos": { "type": "integer", "minimum": 0 },
        "routeTasks": { "type": "integer", "minimum": 0 },
        "violations": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "acceptedExceptions": { "type": "integer", "minimum": 0 }
      }
    },
    "photos": { "type": "array", "items": { "$ref": "#/$defs/photo" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "sourcedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source", "reliable"],
      "properties": {
        "value": {},
        "source": { "enum": ["exif", "manual", "example-track", "missing"] },
        "reliable": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["photoId", "code", "rule", "severity", "affected", "message", "measured", "permitted"],
      "properties": {
        "photoId": { "type": ["string", "null"] },
        "code": { "type": "string" },
        "rule": { "type": "string" },
        "severity": { "enum": ["pass", "warning", "violation"] },
        "affected": { "type": "string" },
        "message": { "type": "string" },
        "measured": { "type": "string" },
        "permitted": { "type": "string" }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "identifier", "identifierMixSalt", "identifierMixAlgorithm", "fileName", "fileSize", "contentHash", "classification", "cameraMetadata", "originalMetadata", "taskPosition", "status", "exceptionAccepted", "exceptionAcceptedAt", "findings", "generatedOrthophoto"],
      "properties": {
        "id": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "identifier": { "type": "string" },
        "identifierMixSalt": { "type": ["string", "null"] },
        "identifierMixAlgorithm": { "type": ["string", "null"] },
        "fileName": { "type": "string" },
        "fileSize": { "type": "integer", "minimum": 0 },
        "contentHash": { "type": "string" },
        "classification": { "enum": ["enroute", "control-correct", "control-false", "sign-task", "reference"] },
        "linkedWaypoint": { "type": ["string", "null"] },
        "cameraMetadata": { "type": "object" },
        "originalMetadata": { "type": "object" },
        "taskPosition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "$ref": "#/$defs/sourcedValue" },
            "longitude": { "$ref": "#/$defs/sourcedValue" }
          }
        },
        "cameraAnalysis": { "type": ["object", "null"] },
        "taskAnalysis": { "type": ["object", "null"] },
        "status": { "enum": ["ok", "against-rules", "manual-review"] },
        "exceptionAccepted": { "type": "boolean" },
        "exceptionAcceptedAt": { "type": ["string", "null"], "format": "date-time" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "generatedOrthophoto": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/generatedOrthophoto" }
          ]
        }
      }
    },
    "generatedOrthophoto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "layer", "targetLabel", "requestedAt", "coverageWidthM", "coverageHeightM", "modeledAltitudeM", "modeledFocalLength35Mm", "modeledDepressionDeg", "attribution"],
      "properties": {
        "provider": { "const": "GURS" },
        "layer": { "const": "DOF025" },
        "targetLabel": { "type": "string" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "coverageWidthM": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 },
        "coverageHeightM": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 },
        "modeledAltitudeM": { "type": "number", "exclusiveMinimum": 0 },
        "modeledFocalLength35Mm": { "type": "number", "exclusiveMinimum": 0 },
        "modeledDepressionDeg": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 },
        "attribution": { "type": "string" },
        "targetSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "elementId", "category", "featureType", "name", "score", "attribution"],
          "properties": {
            "provider": { "const": "OpenStreetMap" },
            "elementId": { "type": "string" },
            "category": { "type": "string" },
            "featureType": { "type": "string" },
            "name": { "type": ["string", "null"] },
            "score": { "type": "number" },
            "attribution": { "type": "string" },
            "selectionSalt": { "type": "string" }
          }
        }
      }
    }
  }
}
